{% extends 'blades/html.njk' %}


{% set content_for_header %}
  <meta name="generator" content="{{ site.generator }}" />
  <meta property="og:title" content="{{ title | d(site.title) | striptags }}" />
  <meta name="twitter:card" content="summary_large_image" />
  <style>
    object {
      /*TODO: move to blades.css */
      vertical-align: middle;
      display: inline-block; /* for Tailwind */
    }
    body > article,
    body > footer {
      text-align: center;
      margin-bottom: 2rem;
      font-size: medium;
    }
  </style>
  {{ content_for_header | safe }}
{% endset %}

{% block body %}
  <article>
    <nav>
      <div>Generated from <code>{{ site.dir | d(buildawesome.directories.input) }}</code></div>
      <div><object data="https://img.shields.io/github/stars/buildawesome-one/examples?label=GitHub"></object></div>
    </nav>
  </article>
  <main class="container breakout-all">{{ content | safe }}</main>
  <hr />
  <footer>{{ site.footer | safe }} © {{ site.year }}</footer>
{% endblock %}
