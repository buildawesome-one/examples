{
  "private": true,
  "name": "tailwind",
  "type": "module",
  "scripts": {
    "precli": "[ -t 1 ] && clear || true",
    "cli": "BA_OPTIONS=--config=../node_modules/@buildawesome.one/config/buildawesome.config.js TW_OPTIONS='--input styles.css --output _public/styles.css' npm -C .cli/ run",
    "start": "npm run cli -- start+tw",
    "stage": "npm run cli -- stage+tw",
    "build": "npm run cli -- build+tw"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/typography": "^0.5.4",
    "tailwindcss": "^4.1.18"
  },
  "--- SITE GLOBALS": "---",
  "site": {
    "base": "https://tailwind.buildawesome.one/",
    "body_attrs": "class='prose lg:prose-xl xl:prose-2xl'",
    "dir": "./tailwind/",
    "footer": "Powered by <object data='https://buildawesome.one/gh.svg' class='dark-auto'></object>",
    "styles": [
      "/styles.css"
    ],
    "title": "11ty / Build Awesome One¹ + Tailwind"
  },
  "---": "---"
}
